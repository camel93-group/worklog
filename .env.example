# docker compose 용 환경 변수 (.env 로 복사해서 사용)
#   cp .env.example .env

# PostgreSQL 비밀번호 — scripts/generate-db-password.sh 로 생성
WORKLOG_DB_PASSWORD=change-me

# 호스트에 노출되는 포트
WORKLOG_DB_PORT=5433
WORKLOG_WEB_PORT=3500

# PostgreSQL 데이터가 저장되는 호스트 디렉터리 (git에 포함하지 않음)
WORKLOG_DATA_DIR=/home/test/workspace/worklog-data

# 봇(voiceMeetBot)이 회의 레코드를 저장하는 호스트 디렉터리 (컨테이너의 /data 로 마운트)
MEETING_DATA_DIR=/home/test/workspace/worklog-data

# ailog 업로드 인증 토큰 — scripts/generate-ailog-token.sh 로 생성
AILOG_TOKEN=change-me
