# Next.js 앱을 호스트에서 직접 실행할 때(npm run dev / next start)의 환경 변수
# docker compose 로 실행할 때는 docker-compose.yml 의 environment 가 대신 주입된다
#   cp .env.local.example .env.local

# 봇(meetbot)이 회의 레코드를 저장하는 디렉터리 — 봇 쪽 DATA_DIR 과 같은 경로
DATA_DIR=/absolute/path/to/worklog-data

# 요약 재생성에 사용하는 Claude Code CLI 경로 (PATH 에 있으면 claude 만으로 충분)
CLAUDE_BIN=claude

# ailog 업로드 인증 토큰
AILOG_TOKEN=change-me

# 비밀번호는 .env 의 WORKLOG_DB_PASSWORD 와 동일하게 맞출 것 (포트는 WORKLOG_DB_PORT)
DATABASE_URL=postgres://worklog:change-me@localhost:5433/worklog
